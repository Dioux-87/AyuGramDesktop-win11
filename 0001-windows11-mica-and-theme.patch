@@ -0,0 +1,50 @@
+// This is the source code of AyuGram for Desktop.
+//
+// We do not and cannot prevent the use of our code,
+// but be respectful and credit the original author.
+//
+// Copyright @Radolyn, 2026
+#pragma once
+
+#include "base/basic_types.h"
+
+class QWidget;
+
+namespace AyuFeatures::Windows11::Platform {
+
+// Backdrop modes exposed by DWM on Windows 11 22H2 and above.
+// Values match DWM_SYSTEMBACKDROP_TYPE from dwmapi.h.
+enum class Backdrop : int {
+	Auto = 0,
+	None = 1,
+	Mica = 2,
+	Acrylic = 3,
+	Tabbed = 4,
+};
+
+// Whether the current OS exposes the Windows 11 backdrop API.
+[[nodiscard]] bool Supported();
+
+// Whether the system transparency effects are enabled by the user.
+[[nodiscard]] bool TransparencyEnabled();
+
+// Whether the system is currently using the dark app theme.
+[[nodiscard]] bool SystemDarkTheme();
+
+// Applies the given backdrop type to the window. Returns false when the
+// platform doesn't support it (another OS or an older Windows build).
+bool ApplyBackdrop(not_null<QWidget*> widget, Backdrop backdrop);
+
+// Sets the rounded corners / border color preferences of the window so the
+// window frame matches the in-app theme.
+void ApplyWindowTheme(not_null<QWidget*> widget, bool dark);
+
+// Applies the system accent color to the window border and title bar,
+// used by the Windows 11 style frame.
+void ApplyWindowBorderColor(not_null<QWidget*> widget);
+
+// Asks DWM to rebuild the backdrop after a theme (light/dark) change so the
+// tint of the Mica material follows the new system palette.
+void RefreshBackdrop(not_null<QWidget*> widget);
+
+} // namespace AyuFeatures::Windows11::Platform
diff --git a/Telegram/SourceFiles/ayu/features/windows11/platform/win/windows11_win.cpp b/Telegram/SourceFiles/ayu/features/windows11/platform/win/windows11_win.cpp
new file mode 100644
index 0000000..c8970ea
--- /dev/null
+++ b/Telegram/SourceFiles/ayu/features/windows11/platform/win/windows11_win.cpp
@@ -0,0 +1,192 @@
+// This is the source code of AyuGram for Desktop.
+//
+// We do not and cannot prevent the use of our code,
+// but be respectful and credit the original author.
+//
+// Copyright @Radolyn, 2026
+#include "ayu/features/windows11/platform/platform_windows11.h"
+
+#ifdef Q_OS_WIN
+
+#include "base/platform/base_platform_info.h"
+
+#include <QtCore/QOperatingSystemVersion>
+
+#include <windows.h>
+#include <dwmapi.h>
+
+namespace AyuFeatures::Windows11::Platform {
+namespace {
+
+// DWMWA_* values introduced in the Windows 11 SDK. Defining them locally keeps
+// the build compatible with older SDKs.
+#ifndef DWMWA_USE_IMMERSIVE_DARK_MODE
+#define DWMWA_USE_IMMERSIVE_DARK_MODE 20
+#endif // DWMWA_USE_IMMERSIVE_DARK_MODE
+#ifndef DWMWA_WINDOW_CORNER_PREFERENCE
+#define DWMWA_WINDOW_CORNER_PREFERENCE 33
+#endif // DWMWA_WINDOW_CORNER_PREFERENCE
+#ifndef DWMWA_BORDER_COLOR
+#define DWMWA_BORDER_COLOR 34
+#endif // DWMWA_BORDER_COLOR
+#ifndef DWMWA_CAPTION_COLOR
+#define DWMWA_CAPTION_COLOR 35
+#endif // DWMWA_CAPTION_COLOR
+#ifndef DWMWA_SYSTEMBACKDROP_TYPE
+#define DWMWA_SYSTEMBACKDROP_TYPE 38
+#endif // DWMWA_SYSTEMBACKDROP_TYPE
+
+#ifndef DWMWCP_DEFAULT
+#define DWMWCP_DEFAULT 0
+#endif // DWMWCP_DEFAULT
+#ifndef DWMWCP_ROUND
+#define DWMWCP_ROUND 2
+#endif // DWMWCP_ROUND
+
+// DWMWA_SYSTEMBACKDROP_TYPE (Mica / Acrylic / Tabbed) is available since
+// Windows 11 22H2 (build 22621).
+constexpr auto kBackdropBuild = 22621;
+
+[[nodiscard]] DWORD BuildNumber() {
+	static const auto result = [] {
+		const auto version = QOperatingSystemVersion::current();
+		if (version.majorVersion() < 10) {
+			return DWORD(0);
+		}
+		return DWORD(version.microVersion());
+	}();
+	return result;
+}
+
+[[nodiscard]] HWND HandleFromWidget(not_null<QWidget*> widget) {
+	return reinterpret_cast<HWND>(widget->winId());
+}
+
+template <typename Value>
+bool SetAttribute(not_null<QWidget*> widget, DWORD attribute, Value value) {
+	return SUCCEEDED(::DwmSetWindowAttribute(
+		HandleFromWidget(widget),
+		attribute,
+		&value,
+		sizeof(value)));
+}
+
+template <typename Name>
+bool ReadPersonalizeDword(Name name, DWORD &out) {
+	const auto keyName = L""
+		"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize";
+	auto key = HKEY();
+	if (::RegOpenKeyEx(HKEY_CURRENT_USER, keyName, 0, KEY_READ, &key)
+		!= ERROR_SUCCESS) {
+		return false;
+	}
+	auto type = DWORD(0);
+	auto size = DWORD(sizeof(out));
+	const auto result = ::RegQueryValueEx(
+		key,
+		name,
+		0,
+		&type,
+		reinterpret_cast<LPBYTE>(&out),
+		&size);
+	::RegCloseKey(key);
+	return (result == ERROR_SUCCESS) && (type == REG_DWORD);
+}
+
+} // namespace
+
+bool Supported() {
+	return ::Platform::IsWindows11OrGreater();
+}
+
+bool TransparencyEnabled() {
+	auto value = DWORD(1);
+	return !ReadPersonalizeDword(L"EnableTransparency", value) || (value != 0);
+}
+
+bool SystemDarkTheme() {
+	auto value = DWORD(1);
+	return ReadPersonalizeDword(L"AppsUseLightTheme", value) && (value == 0);
+}
+
+bool ApplyBackdrop(not_null<QWidget*> widget, Backdrop backdrop) {
+	if (!Supported()) {
+		return false;
+	}
+	// The window must be transparent for DWM to show the backdrop through it.
+	widget->setAttribute(Qt::WA_NoSystemBackground, true);
+	widget->setAttribute(Qt::WA_TranslucentBackground, true);
+
+	// Extending the frame into the whole client area makes DWM paint the
+	// system material behind the window content.
+	const auto margins = MARGINS{ -1, -1, -1, -1 };
+	::DwmExtendFrameIntoClientArea(HandleFromWidget(widget), &margins);
+
+	if (BuildNumber() < kBackdropBuild) {
+		// Fallback for the original Windows 11 release (21H2): only the
+		// undocumented "Mica" flag exists there.
+		auto enabled = BOOL(
+			backdrop != Backdrop::None && TransparencyEnabled());
+		SetAttribute(widget, 1029 /* DWMWA_MICA_EFFECT */, enabled);
+		return true;
+	}
+	auto type = int(backdrop);
+	return SetAttribute(widget, DWMWA_SYSTEMBACKDROP_TYPE, type);
+}
+
+void ApplyWindowTheme(not_null<QWidget*> widget, bool dark) {
+	if (!Supported()) {
+		return;
+	}
+	auto darkValue = BOOL(dark ? TRUE : FALSE);
+	SetAttribute(widget, DWMWA_USE_IMMERSIVE_DARK_MODE, darkValue);
+
+	// The rounded corners are drawn by DWM; ask for the default (rounded)
+	// preference so that a custom translucent window still looks native.
+	auto corners = int(DWMWCP_ROUND);
+	SetAttribute(widget, DWMWA_WINDOW_CORNER_PREFERENCE, corners);
+}
+
+void ApplyWindowBorderColor(not_null<QWidget*> widget) {
+	if (!Supported()) {
+		return;
+	}
+	// DWMWA_COLOR_NONE keeps the system default border, which follows the
+	// user accent color when "Show accent color on title bars" is enabled.
+	constexpr auto kColorNone = DWORD(0xFFFFFFFE);
+	SetAttribute(widget, DWMWA_BORDER_COLOR, kColorNone);
+
+	if (BuildNumber() >= kBackdropBuild) {
+		SetAttribute(widget, DWMWA_CAPTION_COLOR, kColorNone);
+	}
+}
+
+void RefreshBackdrop(not_null<QWidget*> widget) {
+	if (!Supported()) {
+		return;
+	}
+	const auto handle = HandleFromWidget(widget);
+	// Forces DWM to recompute the material with the new system colors.
+	::SetWindowPos(
+		handle,
+		nullptr,
+		0,
+		0,
+		0,
+		0,
+		SWP_FRAMECHANGED
+			| SWP_NOMOVE
+			| SWP_NOSIZE
+			| SWP_NOZORDER
+			| SWP_NOACTIVATE
+			| SWP_NOOWNERZORDER);
+	::RedrawWindow(
+		handle,
+		nullptr,
+		nullptr,
+		RDW_INVALIDATE | RDW_FRAME | RDW_ALLCHILDREN);
+}
+
+} // namespace AyuFeatures::Windows11::Platform
+
+#endif // Q_OS_WIN
diff --git a/Telegram/SourceFiles/ayu/features/windows11/windows11.cpp b/Telegram/SourceFiles/ayu/features/windows11/windows11.cpp
new file mode 100644
index 0000000..8ef5bba
--- /dev/null
+++ b/Telegram/SourceFiles/ayu/features/windows11/windows11.cpp
@@ -0,0 +1,217 @@
+// This is the source code of AyuGram for Desktop.
+//
+// We do not and cannot prevent the use of our code,
+// but be respectful and credit the original author.
+//
+// Copyright @Radolyn, 2026
+#include "ayu/features/windows11/windows11.h"
+
+#include "ayu/ayu_settings.h"
+#include "ayu/features/windows11/platform/platform_windows11.h"
+#include "core/application.h"
+#include "data/data_wall_paper.h"
+#include "core/core_settings.h"
+#include "window/themes/window_theme.h"
+#include "window/window_controller.h"
+
+#include <QtGui/QColor>
+#include <QtGui/QPainter>
+
+namespace AyuFeatures::Windows11 {
+namespace {
+
+rpl::lifetime Lifetime;
+
+InterfaceTheme Applied;
+
+[[nodiscard]] InterfaceTheme InterfaceThemeFromSettings() {
+	return AyuSettings::getInstance().interfaceTheme();
+}
+
+[[nodiscard]] bool NightModeFor(InterfaceTheme theme) {
+	switch (theme) {
+	case InterfaceTheme::Light:
+		return false;
+	case InterfaceTheme::Dark:
+		return true;
+	case InterfaceTheme::System:
+	default:
+		return Platform::SystemDarkTheme();
+	}
+}
+
+void SwitchNightMode(bool night) {
+	if (Window::Theme::IsNightMode() == night) {
+		return;
+	} else if (!Window::Theme::Background()->nightModeChangeAllowed()) {
+		return;
+	}
+	// ToggleNightMode() flips the current mode and the given path selects the
+	// exact theme to apply for the new mode.
+	if (night) {
+		Window::Theme::ToggleNightMode(Window::Theme::NightThemePath());
+	} else {
+		Window::Theme::ToggleNightMode(QString());
+	}
+	Window::Theme::KeepApplied();
+}
+
+void SyncSystemWatch(bool enabled) {
+	auto &settings = Core::App().settings();
+	if (settings.systemDarkModeEnabled() != enabled) {
+		settings.setSystemDarkModeEnabled(enabled);
+	}
+}
+
+void ForEachWindowWidget(Fn<void(not_null<QWidget*>)> callback) {
+	Core::App().enumerateWindows([&](not_null<Window::Controller*> window) {
+		if (const auto widget = window->widget()) {
+			callback(widget);
+		}
+	});
+}
+
+} // namespace
+
+bool MicaEnabled() {
+	if (!AyuSettings::getInstance().micaEffect()) {
+		return false;
+	} else if (!Platform::Supported()) {
+		return false;
+	}
+	return Platform::TransparencyEnabled();
+}
+
+bool UsesDefaultWallPaper() {
+	const auto &paper = Window::Theme::Background()->paper();
+	// The light "day" wall paper is painted as a flat color, so the Mica
+	// material can take over. Everything else (a theme background, any custom
+	// or cloud wall paper and the default night wall paper) is an image, so
+	// the system material stays behind an opaque surface.
+	return Data::IsDefaultWallPaper(paper)
+		&& !Window::Theme::IsNightMode();
+}
+
+bool TranslucentWindow() {
+	if (!MicaEnabled()) {
+		return false;
+	}
+	return UsesDefaultWallPaper();
+}
+
+QColor WindowBgTint() {
+	const auto night = Window::Theme::IsNightMode();
+	const auto base = night ? QColor(32, 32, 32) : QColor(243, 243, 243);
+	// The tint keeps the text readable while still letting the desktop show
+	// through the window.
+	const auto alpha = night ? 200 : 216;
+	return QColor(base.red(), base.green(), base.blue(), alpha);
+}
+
+void FillBackground(QPainter &p, QRect rect) {
+	if (TranslucentWindow()) {
+		p.fillRect(rect, WindowBgTint());
+	}
+}
+
+void UpdateSurface() {
+}
+
+void ApplyBackdrop(not_null<QWidget*> window) {
+	if (!Platform::Supported()) {
+		return;
+	}
+	Platform::ApplyWindowTheme(window, Window::Theme::IsNightMode());
+	Platform::ApplyWindowBorderColor(window);
+
+	const auto translucent = TranslucentWindow();
+	Platform::ApplyBackdrop(
+		window,
+		translucent ? Platform::Backdrop::Mica : Platform::Backdrop::None);
+}
+
+void ApplyBackdropToAllWindows() {
+	ForEachWindowWidget([](not_null<QWidget*> window) {
+		ApplyBackdrop(window);
+	});
+}
+
+void RefreshWindow(not_null<QWidget*> window) {
+	ApplyBackdrop(window);
+	Platform::RefreshBackdrop(window);
+	window->update();
+}
+
+void ApplyInterfaceTheme() {
+	const auto theme = InterfaceThemeFromSettings();
+	Applied = theme;
+	// In the "System" mode the core keeps following the system color scheme.
+	SyncSystemWatch(theme == InterfaceTheme::System);
+	if (theme != InterfaceTheme::System) {
+		SwitchNightMode(NightModeFor(theme));
+	}
+	Core::App().saveSettingsDelayed();
+	HandleThemeUpdate();
+}
+
+void ApplyInitialTheme() {
+	const auto theme = InterfaceThemeFromSettings();
+	Applied = theme;
+	SyncSystemWatch(theme == InterfaceTheme::System);
+	if (theme != InterfaceTheme::System) {
+		SwitchNightMode(NightModeFor(theme));
+	}
+	UpdateSurface();
+}
+
+void ApplyThemeForSystemChange() {
+	if (InterfaceThemeFromSettings() != InterfaceTheme::System) {
+		return;
+	}
+	SwitchNightMode(NightModeFor(InterfaceTheme::System));
+}
+
+void HandleThemeUpdate() {
+	UpdateSurface();
+	ApplyBackdropToAllWindows();
+	ForceRepaint();
+}
+
+void ForceRepaint() {
+	ForEachWindowWidget([](not_null<QWidget*> window) {
+		window->update();
+	});
+}
+
+void StartWatching() {
+	// The system switched between the light and the dark color scheme.
+	Core::App().settings().systemDarkModeChanges(
+	) | rpl::filter([](std::optional<bool> dark) {
+		return dark.has_value();
+	}) | rpl::on_next([=] {
+		ApplyThemeForSystemChange();
+	}, Lifetime);
+
+	// The theme was changed in the AyuGram settings (the settings button only
+	// stores the value, so this is the single place that applies it).
+	AyuSettings::getInstance().interfaceThemeChanges(
+	) | rpl::on_next([=] {
+		ApplyInterfaceTheme();
+	}, Lifetime);
+
+	// The Mica toggle was switched on or off.
+	AyuSettings::getInstance().micaEffectChanges(
+	) | rpl::skip(1) | rpl::on_next([=] {
+		HandleThemeUpdate();
+	}, Lifetime);
+
+	// A wallpaper or a theme was applied, so the palette changed.
+	Window::Theme::Background()->updates(
+	) | rpl::filter([](const Window::Theme::BackgroundUpdate &update) {
+		return update.paletteChanged();
+	}) | rpl::on_next([=] {
+		HandleThemeUpdate();
+	}, Lifetime);
+}
+
+} // namespace AyuFeatures::Windows11
